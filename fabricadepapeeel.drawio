        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class Cargos {\n        +PK CargoID : INT\n        +NomeCargo : VARCHAR(80)\n        +Descricao : VARCHAR(255)\n        +PisoSalarial : DECIMAL(10,2)\n    }\n    class Departamentos {\n        +PK DepartamentoID : INT\n        +NomeDepartamento : VARCHAR(80)\n        +CentroCusto : VARCHAR(20)\n    }\n    class Funcionarios {\n        +PK FuncionarioID : INT\n        +Nome : VARCHAR(100)\n        +CPF : VARCHAR(14)\n        +DataAdmissao : DATE\n        +Salario : DECIMAL(10,2)\n        +Ativo : BOOLEAN\n        +FK CargoID : INT\n        +FK DepartamentoID : INT\n    }\n    class Turnos {\n        +PK TurnoID : INT\n        +NomeTurno : VARCHAR(50)\n        +HoraInicio : TIME\n        +HoraFim : TIME\n    }\n    class FuncionariosTurnos {\n        +PK FuncionarioTurnoID : INT\n        +FK FuncionarioID : INT\n        +FK TurnoID : INT\n        +DataInicio : DATE\n        +DataFim : DATE\n    }\n\n    Cargos \&quot;1\&quot; -- \&quot;0..*\&quot; Funcionarios : possui\n    Departamentos \&quot;1\&quot; -- \&quot;0..*\&quot; Funcionarios : aloca\n    Funcionarios \&quot;1\&quot; -- \&quot;0..*\&quot; FuncionariosTurnos : escala\n    Turnos \&quot;1\&quot; -- \&quot;0..*\&quot; FuncionariosTurnos : define\n\n    class Fornecedores {\n        +PK FornecedorID : INT\n        +RazaoSocial : VARCHAR(120)\n        +CNPJ : VARCHAR(18)\n        +Telefone : VARCHAR(20)\n        +Email : VARCHAR(100)\n        +Cidade : VARCHAR(80)\n    }\n    class CategoriasMateriasPrimas {\n        +PK CategoriaMateriaPrimaID : INT\n        +NomeCategoria : VARCHAR(80)\n        +Descricao : VARCHAR(200)\n    }\n    class MateriasPrimas {\n        +PK MateriaPrimaID : INT\n        +Nome : VARCHAR(100)\n        +UnidadeMedida : VARCHAR(15)\n        +EstoqueMinimo : DECIMAL(10,2)\n        +FK CategoriaMateriaPrimaID : INT\n    }\n    class Compras {\n        +PK CompraID : INT\n        +FK FornecedorID : INT\n        +FK FuncionarioID : INT\n        +DataCompra : DATE\n        +ValorTotal : DECIMAL(12,2)\n        +StatusCompra : VARCHAR(30)\n    }\n    class ItensCompra {\n        +PK ItemCompraID : INT\n        +FK CompraID : INT\n        +FK MateriaPrimaID : INT\n        +Quantidade : DECIMAL(10,2)\n        +PrecoUnitario : DECIMAL(10,2)\n    }\n    class Recebimentos {\n        +PK RecebimentoID : INT\n        +FK CompraID : INT\n        +FK FuncionarioID : INT\n        +DataRecebimento : DATETIME\n        +NumeroNotaFiscal : VARCHAR(44)\n        +Conferido : BOOLEAN\n    }\n    class ContasPagar {\n        +PK ContaPagarID : INT\n        +FK CompraID : INT\n        +DataVencimento : DATE\n        +DataPagamento : DATE\n        +ValorParcela : DECIMAL(10,2)\n        +StatusPagamento : VARCHAR(20)\n    }\n\n    CategoriasMateriasPrimas \&quot;1\&quot; -- \&quot;0..*\&quot; MateriasPrimas : classifica\n    Fornecedores \&quot;1\&quot; -- \&quot;0..*\&quot; Compras : fornece\n    Funcionarios \&quot;1\&quot; -- \&quot;0..*\&quot; Compras : realiza\n    Compras \&quot;1\&quot; -- \&quot;1..*\&quot; ItensCompra : contem\n    MateriasPrimas \&quot;1\&quot; -- \&quot;0..*\&quot; ItensCompra : compoe\n    Compras \&quot;1\&quot; -- \&quot;0..1\&quot; Recebimentos : gera\n    Funcionarios \&quot;1\&quot; -- \&quot;0..*\&quot; Recebimentos : confere\n    Compras \&quot;1\&quot; -- \&quot;1..*\&quot; ContasPagar : origina\n\n    class CategoriasProdutos {\n        +PK CategoriaProdutoID : INT\n        +NomeCategoria : VARCHAR(80)\n        +Descricao : VARCHAR(200)\n    }\n    class Produtos {\n        +PK ProdutoID : INT\n        +NomeProduto : VARCHAR(100)\n        +CodigoSKU : VARCHAR(30)\n        +FolhasTipo : VARCHAR(20)\n        +RolosPorPacote : INT\n        +PrecoVenda : DECIMAL(10,2)\n        +FK CategoriaProdutoID : INT\n    }\n    class FichasTecnicas {\n        +PK FichaTecnicaID : INT\n        +FK ProdutoID : INT\n        +Versao : VARCHAR(10)\n        +DataCriacao : DATE\n        +Ativa : BOOLEAN\n    }\n    class FichasTecnicasItens {\n        +PK FichaTecnicaItemID : INT\n        +FK FichaTecnicaID : INT\n        +FK MateriaPrimaID : INT\n        +QuantidadeNecessaria : DECIMAL(10,4)\n    }\n    class OrdensProducao {\n        +PK OrdemProducaoID : INT\n        +FK ProdutoID : INT\n        +FK FichaTecnicaID : INT\n        +DataEmissao : DATE\n        +DataPrevistaFim : DATE\n        +QuantidadePlanejada : INT\n        +StatusOrdem : VARCHAR(30)\n    }\n    class EtapasProducao {\n        +PK EtapaProducaoID : INT\n        +NomeEtapa : VARCHAR(80)\n        +OrdemSequencia : INT\n        +Descricao : VARCHAR(200)\n    }\n    class TiposMaquinas {\n        +PK TipoMaquinaID : INT\n        +NomeTipo : VARCHAR(80)\n        +Descricao : VARCHAR(200)\n    }\n    class Maquinas {\n        +PK MaquinaID : INT\n        +NomeMaquina : VARCHAR(80)\n        +NumeroSerie : VARCHAR(50)\n        +CapacidadeHora : DECIMAL(10,2)\n        +StatusOperacional : VARCHAR(30)\n        +FK TipoMaquinaID : INT\n    }\n    class ProducaoDiaria {\n        +PK ProducaoDiariaID : INT\n        +FK OrdemProducaoID : INT\n        +FK EtapaProducaoID : INT\n        +FK MaquinaID : INT\n        +FK FuncionarioID : INT\n        +DataProducao : DATE\n        +QuantidadeProduzida : INT\n        +QuantidadeRefugo : INT\n    }\n    class ConsumoMateriais {\n        +PK ConsumoMaterialID : INT\n        +FK OrdemProducaoID : INT\n        +FK MateriaPrimaID : INT\n        +QuantidadeConsumida : DECIMAL(10,2)\n        +DataConsumo : DATETIME\n    }\n    class LotesProducao {\n        +PK LoteProducaoID : INT\n        +FK OrdemProducaoID : INT\n        +CodigoLote : VARCHAR(40)\n        +DataFabricacao : DATE\n        +DataValidade : DATE\n        +QuantidadeLote : INT\n    }\n    class ParadasProducao {\n        +PK ParadaProducaoID : INT\n        +FK MaquinaID : INT\n        +FK OrdemProducaoID : INT\n        +DataHoraInicio : DATETIME\n        +DataHoraFim : DATETIME\n        +Motivo : VARCHAR(150)\n    }\n\n    CategoriasProdutos \&quot;1\&quot; -- \&quot;0..*\&quot; Produtos : agrupa\n    Produtos \&quot;1\&quot; -- \&quot;1..*\&quot; FichasTecnicas : define\n    FichasTecnicas \&quot;1\&quot; -- \&quot;1..*\&quot; FichasTecnicasItens : detalha\n    MateriasPrimas \&quot;1\&quot; -- \&quot;0..*\&quot; FichasTecnicasItens : utilizada_em\n    Produtos \&quot;1\&quot; -- \&quot;0..*\&quot; OrdensProducao : requisita\n    FichasTecnicas \&quot;1\&quot; -- \&quot;0..*\&quot; OrdensProducao : orienta\n    TiposMaquinas \&quot;1\&quot; -- \&quot;0..*\&quot; Maquinas : categoriza\n    OrdensProducao \&quot;1\&quot; -- \&quot;0..*\&quot; ProducaoDiaria : registra\n    EtapasProducao \&quot;1\&quot; -- \&quot;0..*\&quot; ProducaoDiaria : executa\n    Maquinas \&quot;1\&quot; -- \&quot;0..*\&quot; ProducaoDiaria : opera\n    Funcionarios \&quot;1\&quot; -- \&quot;0..*\&quot; ProducaoDiaria : aponta\n    OrdensProducao \&quot;1\&quot; -- \&quot;0..*\&quot; ConsumoMateriais : consome\n    MateriasPrimas \&quot;1\&quot; -- \&quot;0..*\&quot; ConsumoMateriais : baixada\n    OrdensProducao \&quot;1\&quot; -- \&quot;1..*\&quot; LotesProducao : gera\n    Maquinas \&quot;1\&quot; -- \&quot;0..*\&quot; ParadasProducao : sofre\n    OrdensProducao \&quot;1\&quot; -- \&quot;0..*\&quot; ParadasProducao : interrompida\n\n    class Inspecoes {\n        +PK InspecaoID : INT\n        +FK LoteProducaoID : INT\n        +FK FuncionarioID : INT\n        +DataInspecao : DATETIME\n        +ResultadoGeral : VARCHAR(30)\n    }\n    class TestesQualidade {\n        +PK TesteQualidadeID : INT\n        +FK InspecaoID : INT\n        +NomeTeste : VARCHAR(80)\n        +ValorMedido : DECIMAL(10,2)\n        +ValorEsperado : DECIMAL(10,2)\n        +Aprovado : BOOLEAN\n    }\n    class Defeitos {\n        +PK DefeitoID : INT\n        +NomeDefeito : VARCHAR(80)\n        +Gravidade : VARCHAR(20)\n        +Descricao : VARCHAR(200)\n    }\n    class OcorrenciasQualidade {\n        +PK OcorrenciaQualidadeID : INT\n        +FK InspecaoID : INT\n        +FK DefeitoID : INT\n        +QuantidadeAfetada : INT\n        +Observacao : VARCHAR(255)\n    }\n    class AprovacoesLote {\n        +PK AprovacaoLoteID : INT\n        +FK LoteProducaoID : INT\n        +FK FuncionarioID : INT\n        +DataAprovacao : DATETIME\n        +StatusAprovacao : VARCHAR(20)\n        +ParecerTecnico : VARCHAR(255)\n    }\n\n    LotesProducao \&quot;1\&quot; -- \&quot;1..*\&quot; Inspecoes : passa_por\n    Funcionarios \&quot;1\&quot; -- \&quot;0..*\&quot; Inspecoes : inspeciona\n    Inspecoes \&quot;1\&quot; -- \&quot;1..*\&quot; TestesQualidade : contem\n    Inspecoes \&quot;1\&quot; -- \&quot;0..*\&quot; OcorrenciasQualidade : registra\n    Defeitos \&quot;1\&quot; -- \&quot;0..*\&quot; OcorrenciasQualidade : classifica\n    LotesProducao \&quot;1\&quot; -- \&quot;0..1\&quot; AprovacoesLote : recebe\n    Funcionarios \&quot;1\&quot; -- \&quot;0..*\&quot; AprovacoesLote : aprova\n\n    class Armazens {\n        +PK ArmazemID : INT\n        +NomeArmazem : VARCHAR(80)\n        +TipoArmazem : VARCHAR(40)\n        +CapacidadeTotal : DECIMAL(12,2)\n    }\n    class LocalizacoesEstoque {\n        +PK LocalizacaoID : INT\n        +FK ArmazemID : INT\n        +Corredor : VARCHAR(10)\n        +Prateleira : VARCHAR(10)\n        +Nivel : VARCHAR(10)\n    }\n    class Estoques {\n        +PK EstoqueID : INT\n        +FK ProdutoID : INT\n        +FK MateriaPrimaID : INT\n        +FK ArmazemID : INT\n        +QuantidadeAtual : DECIMAL(12,2)\n        +UltimaAtualizacao : DATETIME\n    }\n    class MovimentacoesEstoque {\n        +PK MovimentacaoID : INT\n        +FK EstoqueID : INT\n        +FK FuncionarioID : INT\n        +TipoMovimentacao : VARCHAR(20)\n        +Quantidade : DECIMAL(10,2)\n        +DataMovimentacao : DATETIME\n        +Motivo : VARCHAR(100)\n    }\n    class LotesEstoque {\n        +PK LoteEstoqueID : INT\n        +FK LoteProducaoID : INT\n        +FK LocalizacaoID : INT\n        +QuantidadeDisponivel : INT\n        +DataEntrada : DATETIME\n    }\n    class Inventarios {\n        +PK InventarioID : INT\n        +FK ArmazemID : INT\n        +FK FuncionarioID : INT\n        +DataInventario : DATE\n        +StatusInventario : VARCHAR(30)\n    }\n    class ItensInventario {\n        +PK ItemInventarioID : INT\n        +FK InventarioID : INT\n        +FK EstoqueID : INT\n        +QuantidadeSistema : DECIMAL(12,2)\n        +QuantidadeContada : DECIMAL(12,2)\n    }\n\n    Armazens \&quot;1\&quot; -- \&quot;1..*\&quot; LocalizacoesEstoque : divide_se\n    Armazens \&quot;1\&quot; -- \&quot;0..*\&quot; Estoques : armazena\n    Produtos \&quot;0..1\&quot; -- \&quot;0..*\&quot; Estoques : saldo_produto\n    MateriasPrimas \&quot;0..1\&quot; -- \&quot;0..*\&quot; Estoques : saldo_insumo\n    Estoques \&quot;1\&quot; -- \&quot;0..*\&quot; MovimentacoesEstoque : movimenta\n    Funcionarios \&quot;1\&quot; -- \&quot;0..*\&quot; MovimentacoesEstoque : executa\n    LotesProducao \&quot;1\&quot; -- \&quot;0..*\&quot; LotesEstoque : estocado_em\n    LocalizacoesEstoque \&quot;1\&quot; -- \&quot;0..*\&quot; LotesEstoque : ocupa\n    Armazens \&quot;1\&quot; -- \&quot;0..*\&quot; Inventarios : auditado\n    Funcionarios \&quot;1\&quot; -- \&quot;0..*\&quot; Inventarios : responsavel\n    Inventarios \&quot;1\&quot; -- \&quot;1..*\&quot; ItensInventario : lista\n    Estoques \&quot;1\&quot; -- \&quot;0..*\&quot; ItensInventario : conferido\n\n    class Clientes {\n        +PK ClienteID : INT\n        +RazaoSocial : VARCHAR(120)\n        +CNPJ_CPF : VARCHAR(18)\n        +Telefone : VARCHAR(20)\n        +Email : VARCHAR(100)\n        +Endereco : VARCHAR(200)\n        +Cidade : VARCHAR(80)\n    }\n    class CondicoesPagamento {\n        +PK CondicaoPagamentoID : INT\n        +Descricao : VARCHAR(80)\n        +NumeroParcelas : INT\n        +DiasIntervalo : INT\n    }\n    class Pedidos {\n        +PK PedidoID : INT\n        +FK ClienteID : INT\n        +FK FuncionarioID : INT\n        +FK CondicaoPagamentoID : INT\n        +DataPedido : DATETIME\n        +StatusPedido : VARCHAR(30)\n        +ValorTotal : DECIMAL(12,2)\n    }\n    class ItensPedido {\n        +PK ItemPedidoID : INT\n        +FK PedidoID : INT\n        +FK ProdutoID : INT\n        +Quantidade : INT\n        +PrecoUnitario : DECIMAL(10,2)\n    }\n    class Vendas {\n        +PK VendaID : INT\n        +FK PedidoID : INT\n        +DataVenda : DATETIME\n        +ValorFinal : DECIMAL(12,2)\n        +Desconto : DECIMAL(10,2)\n    }\n    class NotasFiscais {\n        +PK NotaFiscalID : INT\n        +FK VendaID : INT\n        +NumeroNF : VARCHAR(20)\n        +Serie : VARCHAR(5)\n        +ChaveAcesso : VARCHAR(44)\n        +DataEmissao : DATETIME\n    }\n    class ContasReceber {\n        +PK ContaReceberID : INT\n        +FK VendaID : INT\n        +DataVencimento : DATE\n        +DataRecebimento : DATE\n        +ValorParcela : DECIMAL(10,2)\n        +StatusRecebimento : VARCHAR(20)\n    }\n\n    Clientes \&quot;1\&quot; -- \&quot;0..*\&quot; Pedidos : faz\n    Funcionarios \&quot;1\&quot; -- \&quot;0..*\&quot; Pedidos : vende\n    CondicoesPagamento \&quot;1\&quot; -- \&quot;0..*\&quot; Pedidos : rege\n    Pedidos \&quot;1\&quot; -- \&quot;1..*\&quot; ItensPedido : contem\n    Produtos \&quot;1\&quot; -- \&quot;0..*\&quot; ItensPedido : vendido_em\n    Pedidos \&quot;1\&quot; -- \&quot;0..1\&quot; Vendas : efetiva\n    Vendas \&quot;1\&quot; -- \&quot;1\&quot; NotasFiscais : emite\n    Vendas \&quot;1\&quot; -- \&quot;1..*\&quot; ContasReceber : gera\n\n    class Transportadoras {\n        +PK TransportadoraID : INT\n        +NomeTransportadora : VARCHAR(120)\n        +CNPJ : VARCHAR(18)\n        +Telefone : VARCHAR(20)\n    }\n    class Veiculos {\n        +PK VeiculoID : INT\n        +FK TransportadoraID : INT\n        +Placa : VARCHAR(10)\n        +Modelo : VARCHAR(60)\n        +CapacidadeCargaKg : DECIMAL(10,2)\n    }\