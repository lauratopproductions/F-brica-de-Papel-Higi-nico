        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    CARGOS ||--o{ FUNCIONARIOS : possui\n    DEPARTAMENTOS ||--o{ FUNCIONARIOS : aloca\n    FUNCIONARIOS ||--o{ FUNCIONARIOSTURNOS : participa\n    TURNOS ||--o{ FUNCIONARIOSTURNOS : compoe\n\n    CARGOS {\n        INT CargoID PK\n        VARCHAR NomeCargo\n        VARCHAR Descricao\n        DECIMAL PisoSalarial\n    }\n    DEPARTAMENTOS {\n        INT DepartamentoID PK\n        VARCHAR NomeDepartamento\n        VARCHAR CentroCusto\n    }\n    FUNCIONARIOS {\n        INT FuncionarioID PK\n        VARCHAR Nome\n        VARCHAR CPF\n        DATE DataAdmissao\n        DECIMAL Salario\n        BOOLEAN Ativo\n        INT CargoID FK\n        INT DepartamentoID FK\n    }\n    TURNOS {\n        INT TurnoID PK\n        VARCHAR NomeTurno\n        TIME HoraInicio\n        TIME HoraFim\n    }\n    FUNCIONARIOSTURNOS {\n        INT FuncionarioTurnoID PK\n        INT FuncionarioID FK\n        INT TurnoID FK\n        DATE DataInicio\n        DATE DataFim\n    }\n\n    CATEGORIASMATERIASPRIMAS ||--o{ MATERIASPRIMAS : classifica\n    FORNECEDORES ||--o{ COMPRAS : realiza\n    FUNCIONARIOS ||--o{ COMPRAS : efetua\n    COMPRAS ||--|{ ITENSCOMPRA : contem\n    MATERIASPRIMAS ||--o{ ITENSCOMPRA : listada\n    COMPRAS ||--o| RECEBIMENTOS : origina\n    FUNCIONARIOS ||--o{ RECEBIMENTOS : confere\n    COMPRAS ||--|{ CONTASPAGAR : gera\n\n    CATEGORIASMATERIASPRIMAS {\n        INT CategoriaMateriaPrimaID PK\n        VARCHAR NomeCategoria\n        VARCHAR Descricao\n    }\n    MATERIASPRIMAS {\n        INT MateriaPrimaID PK\n        VARCHAR Nome\n        VARCHAR UnidadeMedida\n        DECIMAL EstoqueMinimo\n        INT CategoriaMateriaPrimaID FK\n    }\n    FORNECEDORES {\n        INT FornecedorID PK\n        VARCHAR RazaoSocial\n        VARCHAR CNPJ\n        VARCHAR Telefone\n        VARCHAR Email\n        VARCHAR Cidade\n    }\n    COMPRAS {\n        INT CompraID PK\n        INT FornecedorID FK\n        INT FuncionarioID FK\n        DATE DataCompra\n        DECIMAL ValorTotal\n        VARCHAR StatusCompra\n    }\n    ITENSCOMPRA {\n        INT ItemCompraID PK\n        INT CompraID FK\n        INT MateriaPrimaID FK\n        DECIMAL Quantidade\n        DECIMAL PrecoUnitario\n    }\n    RECEBIMENTOS {\n        INT RecebimentoID PK\n        INT CompraID FK\n        INT FuncionarioID FK\n        DATETIME DataRecebimento\n        VARCHAR NumeroNotaFiscal\n        BOOLEAN Conferido\n    }\n    CONTASPAGAR {\n        INT ContaPagarID PK\n        INT CompraID FK\n        DATE DataVencimento\n        DATE DataPagamento\n        DECIMAL ValorParcela\n        VARCHAR StatusPagamento\n    }\n\n    CATEGORIASPRODUTOS ||--o{ PRODUTOS : agrupa\n    PRODUTOS ||--|{ FICHASTECNICAS : possui\n    FICHASTECNICAS ||--|{ FICHASTECNICASITENS : estrutura\n    MATERIASPRIMAS ||--o{ FICHASTECNICASITENS : integra\n    PRODUTOS ||--o{ ORDENSPRODUCAO : demanda\n    FICHASTECNICAS ||--o{ ORDENSPRODUCAO : especifica\n    TIPOSMAQUINAS ||--o{ MAQUINAS : define\n    ORDENSPRODUCAO ||--o{ PRODUCAODIARIA : aponta\n    ETAPASPRODUCAO ||--o{ PRODUCAODIARIA : etapa\n    MAQUINAS ||--o{ PRODUCAODIARIA : maquina\n    FUNCIONARIOS ||--o{ PRODUCAODIARIA : operador\n    ORDENSPRODUCAO ||--o{ CONSUMOMATERIAIS : consome\n    MATERIASPRIMAS ||--o{ CONSUMOMATERIAIS : insumo\n    ORDENSPRODUCAO ||--|{ LOTESPRODUCAO : produz\n    MAQUINAS ||--o{ PARADASPRODUCAO : para\n    ORDENSPRODUCAO ||--o{ PARADASPRODUCAO : afeta\n\n    CATEGORIASPRODUTOS {\n        INT CategoriaProdutoID PK\n        VARCHAR NomeCategoria\n        VARCHAR Descricao\n    }\n    PRODUTOS {\n        INT ProdutoID PK\n        VARCHAR NomeProduto\n        VARCHAR CodigoSKU\n        VARCHAR FolhasTipo\n        INT RolosPorPacote\n        DECIMAL PrecoVenda\n        INT CategoriaProdutoID FK\n    }\n    FICHASTECNICAS {\n        INT FichaTecnicaID PK\n        INT ProdutoID FK\n        VARCHAR Versao\n        DATE DataCriacao\n        BOOLEAN Ativa\n    }\n    FICHASTECNICASITENS {\n        INT FichaTecnicaItemID PK\n        INT FichaTecnicaID FK\n        INT MateriaPrimaID FK\n        DECIMAL QuantidadeNecessaria\n    }\n    ORDENSPRODUCAO {\n        INT OrdemProducaoID PK\n        INT ProdutoID FK\n        INT FichaTecnicaID FK\n        DATE DataEmissao\n        DATE DataPrevistaFim\n        INT QuantidadePlanejada\n        VARCHAR StatusOrdem\n    }\n    ETAPASPRODUCAO {\n        INT EtapaProducaoID PK\n        VARCHAR NomeEtapa\n        INT OrdemSequencia\n        VARCHAR Descricao\n    }\n    TIPOSMAQUINAS {\n        INT TipoMaquinaID PK\n        VARCHAR NomeTipo\n        VARCHAR Descricao\n    }\n    MAQUINAS {\n        INT MaquinaID PK\n        VARCHAR NomeMaquina\n        VARCHAR NumeroSerie\n        DECIMAL CapacidadeHora\n        VARCHAR StatusOperacional\n        INT TipoMaquinaID FK\n    }\n    PRODUCAODIARIA {\n        INT ProducaoDiariaID PK\n        INT OrdemProducaoID FK\n        INT EtapaProducaoID FK\n        INT MaquinaID FK\n        INT FuncionarioID FK\n        DATE DataProducao\n        INT QuantidadeProduzida\n        INT QuantidadeRefugo\n    }\n    CONSUMOMATERIAIS {\n        INT ConsumoMaterialID PK\n        INT OrdemProducaoID FK\n        INT MateriaPrimaID FK\n        DECIMAL QuantidadeConsumida\n        DATETIME DataConsumo\n    }\n    LOTESPRODUCAO {\n        INT LoteProducaoID PK\n        INT OrdemProducaoID FK\n        VARCHAR CodigoLote\n        DATE DataFabricacao\n        DATE DataValidade\n        INT QuantidadeLote\n    }\n    PARADASPRODUCAO {\n        INT ParadaProducaoID PK\n        INT MaquinaID FK\n        INT OrdemProducaoID FK\n        DATETIME DataHoraInicio\n        DATETIME DataHoraFim\n        VARCHAR Motivo\n    }\n\n    LOTESPRODUCAO ||--|{ INSPECOES : avaliado\n    FUNCIONARIOS ||--o{ INSPECOES : inspetor\n    INSPECOES ||--|{ TESTESQUALIDADE : realiza\n    INSPECOES ||--o{ OCORRENCIASQUALIDADE : identifica\n    DEFEITOS ||--o{ OCORRENCIASQUALIDADE : tipifica\n    LOTESPRODUCAO ||--o| APROVACOESLOTE : libera\n    FUNCIONARIOS ||--o{ APROVACOESLOTE : responsavel\n\n    INSPECOES {\n        INT InspecaoID PK\n        INT LoteProducaoID FK\n        INT FuncionarioID FK\n        DATETIME DataInspecao\n        VARCHAR ResultadoGeral\n    }\n    TESTESQUALIDADE {\n        INT TesteQualidadeID PK\n        INT InspecaoID FK\n        VARCHAR NomeTeste\n        DECIMAL ValorMedido\n        DECIMAL ValorEsperado\n        BOOLEAN Aprovado\n    }\n    DEFEITOS {\n        INT DefeitoID PK\n        VARCHAR NomeDefeito\n        VARCHAR Gravidade\n        VARCHAR Descricao\n    }\n    OCORRENCIASQUALIDADE {\n        INT OcorrenciaQualidadeID PK\n        INT InspecaoID FK\n        INT DefeitoID FK\n        INT QuantidadeAfetada\n        VARCHAR Observacao\n    }\n    APROVACOESLOTE {\n        INT AprovacaoLoteID PK\n        INT LoteProducaoID FK\n        INT FuncionarioID FK\n        DATETIME DataAprovacao\n        VARCHAR StatusAprovacao\n        VARCHAR ParecerTecnico\n    }\n\n    ARMAZENS ||--|{ LOCALIZACOESESTOQUE : contem\n    ARMAZENS ||--o{ ESTOQUES : guarda\n    PRODUTOS ||--o{ ESTOQUES : saldo_prod\n    MATERIASPRIMAS ||--o{ ESTOQUES : saldo_mp\n    ESTOQUES ||--o{ MOVIMENTACOESESTOQUE : registra\n    FUNCIONARIOS ||--o{ MOVIMENTACOESESTOQUE : movimenta\n    LOTESPRODUCAO ||--o{ LOTESESTOQUE : armazenado\n    LOCALIZACOESESTOQUE ||--o{ LOTESESTOQUE : endereco\n    ARMAZENS ||--o{ INVENTARIOS : inventariado\n    FUNCIONARIOS ||--o{ INVENTARIOS : auditor\n    INVENTARIOS ||--|{ ITENSINVENTARIO : itens\n    ESTOQUES ||--o{ ITENSINVENTARIO : saldo_auditado\n\n    ARMAZENS {\n        INT ArmazemID PK\n        VARCHAR NomeArmazem\n        VARCHAR TipoArmazem\n        DECIMAL CapacidadeTotal\n    }\n    LOCALIZACOESESTOQUE {\n        INT LocalizacaoID PK\n        INT ArmazemID FK\n        VARCHAR Corredor\n        VARCHAR Prateleira\n        VARCHAR Nivel\n    }\n    ESTOQUES {\n        INT EstoqueID PK\n        INT ProdutoID FK\n        INT MateriaPrimaID FK\n        INT ArmazemID FK\n        DECIMAL QuantidadeAtual\n        DATETIME UltimaAtualizacao\n    }\n    MOVIMENTACOESESTOQUE {\n        INT MovimentacaoID PK\n        INT EstoqueID FK\n        INT FuncionarioID FK\n        VARCHAR TipoMovimentacao\n        DECIMAL Quantidade\n        DATETIME DataMovimentacao\n        VARCHAR Motivo\n    }\n    LOTESESTOQUE {\n        INT LoteEstoqueID PK\n        INT LoteProducaoID FK\n        INT LocalizacaoID FK\n        INT QuantidadeDisponivel\n        DATETIME DataEntrada\n    }\n    INVENTARIOS {\n        INT InventarioID PK\n        INT ArmazemID FK\n        INT FuncionarioID FK\n        DATE DataInventario\n        VARCHAR StatusInventario\n    }\n    ITENSINVENTARIO {\n        INT ItemInventarioID PK\n        INT InventarioID FK\n        INT EstoqueID FK\n        DECIMAL QuantidadeSistema\n        DECIMAL QuantidadeContada\n    }\n\n    CLIENTES ||--o{ PEDIDOS : solicita\n    FUNCIONARIOS ||--o{ PEDIDOS : vendedor\n    CONDICOESPAGAMENTO ||--o{ PEDIDOS : condicao\n    PEDIDOS ||--|{ ITENSPEDIDO : itens\n    PRODUTOS ||--o{ ITENSPEDIDO : produto\n    PEDIDOS ||--o| VENDAS : converte\n    VENDAS ||--|| NOTASFISCAIS : fatura\n    VENDAS ||--|{ CONTASRECEBER : parcelas\n\n    CLIENTES {\n        INT ClienteID PK\n        VARCHAR RazaoSocial\n        VARCHAR CNPJ_CPF\n        VARCHAR Telefone\n        VARCHAR Email\n        VARCHAR Endereco\n        VARCHAR Cidade\n    }\n    CONDICOESPAGAMENTO {\n        INT CondicaoPagamentoID PK\n        VARCHAR Descricao\n        INT NumeroParcelas\n        INT DiasIntervalo\n    }\n    PEDIDOS {\n        INT PedidoID PK\n        INT ClienteID FK\n        INT FuncionarioID FK\n        INT CondicaoPagamentoID FK\n        DATETIME DataPedido\n        VARCHAR StatusPedido\n        DECIMAL ValorTotal\n    }\n    ITENSPEDIDO {\n        INT ItemPedidoID PK\n        INT PedidoID FK\n        INT ProdutoID FK\n        INT Quantidade\n        DECIMAL PrecoUnitario\n    }\n    VENDAS {\n        INT VendaID PK\n        INT PedidoID FK\n        DATETIME DataVenda\n        DECIMAL ValorFinal\n        DECIMAL Desconto\n    }\n    NOTASFISCAIS {\n        INT NotaFiscalID PK\n        INT VendaID FK\n        VARCHAR NumeroNF\n        VARCHAR Serie\n        VARCHAR ChaveAcesso\n        DATETIME DataEmissao\n    }\n    CONTASRECEBER {\n        INT ContaReceberID PK\n        INT VendaID FK\n        DATE DataVencimento\n        DATE DataRecebimento\n        DECIMAL ValorParcela\n        VARCHAR StatusRecebimento\n    }\n\n    TRANSPORTADORAS ||--|{ VEICULOS : possui\n    VENDAS ||--|{ ENTREGAS : entrega\n    VEICULOS ||--o{ ENTREGAS : transporta\n    ROTAS ||--o{ ENTREGAS : trajeto\n    ENTREGAS ||--|{ ITENSENTREGA : carga\n    LOTESESTOQUE ||--o{ ITENSENTREGA : lote_expedido\n\n    TRANSPORTADORAS {\n        INT TransportadoraID PK\n        VARCHAR NomeTransportadora\n        VARCHAR CNPJ\n        VARCHAR Telefone\n    }\n    VEICULOS {\n        INT VeiculoID PK\n        INT TransportadoraID FK\n        VARCHAR Placa\n        VARCHAR Modelo\n        DECIMAL CapacidadeCargaKg\n    }\n    ROTAS {\n        INT RotaID PK\n        VARCHAR NomeRota\n        VARCHAR Origem\n        VARCHAR Destino\n        DECIMAL DistanciaKm\n    }\n    ENTREGAS {\n        INT EntregaID PK\n        INT VendaID FK\n        INT VeiculoID FK\n        INT RotaID FK\n        DATETIME DataSaida\n        DATE DataEntregaPrevista\n        DATETIME DataEntregaRealizada\n        VARCHAR StatusEntrega\n    }\n    ITENSENTREGA {\n        INT ItemEntregaID PK\n        INT EntregaID FK\n        INT LoteEstoqueID FK\n        INT QuantidadeCarregada\n    }\n\n    MAQUINAS ||--o{ MANUTENCOES : historico\n    TIPOSMANUTENCAO ||--o{ MANUTENCOES : tipo\n    FUNCIONARIOS ||--o{ MANUTENCOES : tecnico\n\n    TIPOSMANUTENCAO {\n        INT TipoManutencaoID PK\n        VARCHAR NomeTipo\n        VARCHAR Descricao\n    }\n    MANUTENCOES {\n        INT ManutencaoID PK\n        INT MaquinaID FK\n        INT TipoManutencaoID FK\n        INT FuncionarioID FK\n        DATETIME DataInicio\n        DATETIME DataFim\n        DECIMAL CustoTotal\n        VARCHAR DescricaoServico\n    }\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="_mHVs7iK5QHXEv7Kqwl6-107">
