        <UserObject label="tecnico" mermaidId="e:FUNCIONARIOS-&gt;MANUTENCOES#0" mermaidBaseStyle="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;startArrow=ERmandOne;startSize=14;endArrow=ERzeroToMany;endSize=14;jumpStyle=arc;jumpSize=12;strokeColor=#000000;strokeWidth=2;html=1;fontSize=14;labelBackgroundColor=#FFFFFF;fontFamily=Recursive;fontColor=#28253D;exitX=0.8;exitY=1;entryX=0.27;entryY=0;" mermaidBaseValue="tecnico" id="_mHVs7iK5QHXEv7Kqwl6-1281">
